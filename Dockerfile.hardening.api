# Post-build security refresh over the pristine upstream API image. The
# upstream build stays byte-exact from UPSTREAM_COMMIT; this derivative only
# fixes what upstream does not control and cannot be fixed any other way
# without forking:
#   - OS packages inherited stale from the base image;
#   - the node base image's bundled npm CLI, removed outright: the API's CMD
#     is plain `node dist/src/harness.js`, and even the newest npm majors
#     keep vendoring vulnerable deps (tar, sigstore, brace-expansion, ...).
# App-level dependencies under /app are intentionally NOT touched: they are
# upstream's tested lockfile. Unfixable findings there are accepted per
# security/accepted-risks-api.trivyignore.yaml with expiry dates.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
RUN apt-get update \
    && apt-get -y dist-upgrade \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
