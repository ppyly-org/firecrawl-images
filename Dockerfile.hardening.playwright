# Post-build security refresh over the pristine upstream Playwright image.
# Same policy as Dockerfile.hardening.api: dist-upgrade the stale base-image
# OS packages (node:18-slim ships months-old Debian) and remove the bundled
# npm CLI with its perpetually-lagging vendored deps. Upstream's CMD is
# `npm start`, which package.json defines as exactly `node dist/api.js` —
# baked here verbatim so the runtime no longer needs npm at all.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
RUN apt-get update \
    && apt-get -y dist-upgrade \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
CMD ["node", "dist/api.js"]
