# Post-build security refresh over the pristine upstream image. The upstream
# build stays byte-exact from UPSTREAM_COMMIT; this derivative only patches
# components upstream does not pin on purpose and cannot be fixed any other
# way without forking:
#   - OS packages inherited stale from the base image (Playwright's
#     mcr/node:18 base ships months-old Debian packages with published fixes)
#   - the node base image's bundled npm CLI, whose vendored deps (tar,
#     sigstore, glob, minimatch, ...) carry fixed-upstream CVEs; Playwright's
#     CMD is "npm start" so npm must stay, at its latest supported major
#     (node:18 cannot run npm 11 — hence the per-image NPM_MAJOR arg).
# App-level dependencies under /app are intentionally NOT touched here: they
# are upstream's tested lockfile. Unfixable findings there are accepted per
# security/accepted-risks-*.trivyignore.yaml with expiry dates.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG NPM_MAJOR
RUN apt-get update \
    && apt-get -y dist-upgrade \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g "npm@${NPM_MAJOR:?}" \
    && npm cache clean --force
